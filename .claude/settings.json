{
  "autoCompactEnabled": true,
  "autoCompactWindow": 150000,
  "verbose": false,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add apps/*)",
      "Bash(git add packages/*)",
      "Bash(git add .claude/*)",
      "Bash(git commit*)",
      "Bash(git push)",
      "Bash(git show*)",
      "Bash(git stash*)",
      "Bash(git checkout -- *)",
      "Bash(git branch)",
      "Bash(git fetch)",
      "Bash(git pull)",
      "Bash(npm run *)",
      "Bash(npm install*)",
      "Bash(npm ci)",
      "Bash(npx *)",
      "Bash(node -e *)",
      "Bash(node --input-type=module*)",
      "Bash(node apps/*)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(find apps/*)",
      "Bash(find packages/*)",
      "Bash(grep *)",
      "Bash(cat apps/*)",
      "Bash(cat packages/*)",
      "Bash(cat .claude/*)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(mkdir -p apps/*)",
      "Bash(mkdir -p packages/*)",
      "Bash(cp apps/*)",
      "Bash(mv apps/*)",
      "Bash(touch apps/*)",
      "Bash(jq *)",
      "Read",
      "Edit",
      "Write",
      "Bash(curl -s *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git clean -f*)",
      "Bash(git rebase*)",
      "Bash(rm -rf apps/*)",
      "Bash(rm -rf packages/*)",
      "Bash(rm -rf src/*)",
      "Bash(* .env*)",
      "Bash(cat */.env*)",
      "Bash(echo * > */.env*)",
      "Bash(rm /Users/*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(* /etc/*)",
      "Bash(* /usr/*)",
      "Bash(* /var/*)",
      "Bash(mongodrop*)",
      "Bash(mongo * --eval *drop*)",
      "Bash(redis-cli flushall*)",
      "Bash(redis-cli flushdb*)",
      "Bash(npm publish*)",
      "Bash(npx prisma migrate reset*)"
    ]
  }
}
