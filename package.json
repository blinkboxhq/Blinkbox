{
  "name": "blinkbox",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "test:backend": "npm test --workspace=apps/backend",
    "typecheck:backend": "npm run typecheck --workspace=apps/backend",
    "registry:check": "node scripts/check-node-registry.mjs",
    "lint": "eslint .",
    "check": "npm run registry:check && npm run typecheck:backend && npm run lint"
  },
  "dependencies": {
    "claude": "^0.1.1",
    "ioredis": "^5.9.2",
    "motion-dom": "^12.36.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}
