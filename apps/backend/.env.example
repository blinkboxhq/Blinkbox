# ── Required ──────────────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change_me_min_32_chars_random_string
ENCRYPTION_KEY=exactly_32_chars_random_string!!

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=blinkbox

# ── Redis (Railway adds this automatically when you add a Redis service) ──────
REDIS_URL=redis://default:password@host:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
BACKEND_URL=https://your-service.up.railway.app

# ── Integrations (optional — only needed if using those nodes) ────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
