# Blinkbox — env template for running from a source checkout.
#
#   cp docker/env.example .env && $EDITOR .env
#   docker compose up -d          # then open http://localhost
#
# This is a developer file. To install Blinkbox on a server, use the installer,
# which writes its own .env and reserves you a subdomain with a certificate:
#   curl -fsSL https://raw.githubusercontent.com/blinkboxhq/Blinkbox/main/docker/install.sh | sudo sh

# ── Required ──────────────────────────────────────────────────────────────────

# Your self-hosted license key. Mint one at blinkbox.net → Settings → Self-hosting.
# This is what carries your plan and purchased credits into this install — it is
# a bearer token for the credits API only, never a database credential.
SELF_HOST_LICENSE_KEY=bb_selfhost_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The account that owns this instance. The owner password is generated inside
# the container and printed once by:
#   docker compose exec backend node apps/backend/src/modules/selfhost/seedOwner.js
OWNER_EMAIL=you@example.com

# Signs login sessions for THIS install. Generate your own:
#   openssl rand -hex 32
JWT_SECRET=

# Encrypts stored integration credentials. Must be EXACTLY 32 characters:
#   openssl rand -hex 16
# Changing this after first run makes existing saved credentials unreadable.
ENCRYPTION_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────

# local   — the mongo and redis services in docker-compose.yml run here and hold
#           everything. COMPOSE_PROFILES=local is what starts them.
# managed — Blinkbox runs them for you; the backend fetches credentials scoped to
#           this instance at boot and never writes them to disk. Leave
#           COMPOSE_PROFILES empty so the local services stay out of the project.
SELF_HOST_STORAGE=local
COMPOSE_PROFILES=local

# Do not set MONGODB_URI, REDIS_URL or REDIS_KEY_PREFIX by hand in managed mode.
# The backend leases all three from the Blinkbox cloud at boot and overwrites
# whatever is here; the prefix in particular must match the namespace this
# instance's Redis ACL user is fenced to, or the very first command is refused.

# ── Networking ────────────────────────────────────────────────────────────────

# Caddy is the only published listener: it holds :80 and :443, and the backend
# and frontend are reachable only through it. ":80" serves any host over plain
# HTTP, which is what you want locally. A real hostname here makes Caddy fetch a
# certificate for it, so it must already resolve to this machine.
BLINKBOX_HOSTNAME=:80

# Where this install is reachable — through Caddy, not the container ports.
# No rebuild is needed when these change: the frontend talks to whatever origin
# serves it.
BACKEND_PUBLIC_URL=http://localhost
CORS_ORIGINS=http://localhost

# ── Optional ──────────────────────────────────────────────────────────────────

# Only change this if Blinkbox told you to.
CLOUD_API_URL=https://api.blinkbox.net

# Pin the images instead of tracking :latest.
# BLINKBOX_TAG=latest

# Your own provider keys — AI and email nodes use these directly, no proxying.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
