# Blinkbox self-hosted — the installer writes this file for you:
#   curl -fsSL https://get.blinkbox.net/install.sh | sudo sh
# This template is for building from source by hand instead.
#   cp docker/env.example .env

# ── Required ──────────────────────────────────────────────────────────────────

# Your self-hosted license key. Mint one at blinkbox.net → Settings → Self-hosting.
# This is what carries your plan and purchased credits into this install — it is
# a bearer token for the credits API only, never a database credential.
SELF_HOST_LICENSE_KEY=bb_selfhost_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signs login sessions for THIS install. Generate your own:
#   openssl rand -hex 32
JWT_SECRET=

# Encrypts stored integration credentials. Must be EXACTLY 32 characters:
#   openssl rand -hex 16
# Changing this after first run makes existing saved credentials unreadable.
ENCRYPTION_KEY=

# ── Networking ────────────────────────────────────────────────────────────────

# The hostname Caddy serves and gets a certificate for. Leave as :80 to run on
# plain HTTP with no domain. The installer sets this to <name>.blinkbox.net.
BLINKBOX_HOSTNAME=:80

# Where this install is reachable. No rebuild is needed when these change —
# the frontend talks to whatever origin serves it.
BACKEND_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8080

FRONTEND_PORT=8080
BACKEND_PORT=3000

# ── Optional ──────────────────────────────────────────────────────────────────

# Only change this if Blinkbox told you to.
CLOUD_API_URL=https://api.blinkbox.net

# Your own provider keys — AI and email nodes use these directly, no proxying.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
